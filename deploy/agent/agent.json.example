{
  "_comment": "MeshMorphic agent configuration. The installer writes this for you; it is here so a machine can be rebuilt from a file rather than from memory.",

  "_gateways": "Introduction points. Each is an address and the public key expected to answer there — an address alone is never enough, because dialling somewhere without knowing which key should answer is exactly what this system refuses to do. Any one working gateway is sufficient; more is better, and the agent learns about others as it goes.",
  "gateways": [
    {
      "addr": "gw1.awwwe.uk:7777",
      "pubkey": "REPLACE_WITH_GATEWAY_PUBLIC_KEY"
    }
  ],

  "_upstream": "The local website. In the packaged setup this is the sandboxed site container, which has no route anywhere else.",
  "upstream": "http://site:8080",

  "state_dir": "/var/lib/meshmorphic",
  "site_dir": "/var/lib/meshmorphic/site",

  "_panel_listen": "The settings panel. Bound to the home network, never to the internet.",
  "panel_listen": "0.0.0.0:8800",

  "_custom_hostnames": "Domains you own. Normally added in the panel rather than here.",
  "custom_hostnames": [],

  "_acme_email": "Optional. Let's Encrypt uses it to warn you if a certificate is about to expire and has not renewed. Leave empty to send them nothing.",
  "acme_email": "",

  "_acme_staging": "Set true when testing. Certificates will not be trusted by browsers, but the rate limits are generous. Production limits are unforgiving, so use this while experimenting.",
  "acme_staging": false
}
